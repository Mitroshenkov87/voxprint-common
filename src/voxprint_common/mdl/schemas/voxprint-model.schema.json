{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voxprint.dev/schemas/voxprint-model/1",
  "title": "voxprint-model/1",
  "description": "Shared model manifest, schema id voxprint-model/1. The properties in required are mandatory. mirror_policy and file_groups are optional; a missing mirror_policy means race. license is the SPDX id, spelled license. VRAM fields are GiB: a 24 GB card is recorded as about 23.5 GiB (GB * 1000 / 1024, nearest 0.5). files[].path is relative to the repo root and is the same string on every mirror. sources on a file or a file group replaces mirrors for those paths. voxprint-model.json is not listed in files.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "display_name",
    "app_ids",
    "task",
    "license",
    "files",
    "mirrors",
    "tier",
    "runtime",
    "base_model",
    "card_url",
    "flags",
    "on_demand",
    "build"
  ],
  "properties": {
    "schema": {"const": "voxprint-model/1"},
    "id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "display_name": {"type": "string", "minLength": 1},
    "app_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "task": {"type": "string", "minLength": 1},
    "license": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9.+-]*$",
      "description": "Lowercase SPDX licence id. The key is license, not licence."
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!voxprint-model\\.json$)(?!/)(?!.*\\\\)(?!.*\\.\\./)[^\\\\]+$"
          },
          "size": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "mirror_policy": {"enum": ["race", "strict-priority"]},
          "sources": {"$ref": "#/$defs/mirrors"}
        }
      }
    },
    "mirrors": {"$ref": "#/$defs/mirrors"},
    "mirror_policy": {"enum": ["race", "strict-priority"]},
    "file_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["paths"],
        "properties": {
          "paths": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "mirror_policy": {"enum": ["race", "strict-priority"]},
          "sources": {"$ref": "#/$defs/mirrors"}
        }
      }
    },
    "tier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_vram_gib", "recommended_vram_gib", "gpu_min_cc"],
      "properties": {
        "min_vram_gib": {"type": "number", "minimum": 0},
        "recommended_vram_gib": {"type": "number", "minimum": 0},
        "gpu_min_cc": {"type": "number", "minimum": 0}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "version_req"],
      "properties": {
        "engine": {"enum": ["llama.cpp", "diffusers", "nunchaku"]},
        "version_req": {"type": "string", "minLength": 1}
      }
    },
    "base_model": {"type": "string"},
    "card_url": {"type": "string", "pattern": "^(?:|https://\\S+)$"},
    "flags": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "on_demand": {"type": "boolean"},
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["forge_version", "tag", "date"],
      "properties": {
        "forge_version": {"type": "string", "minLength": 1},
        "tag": {
          "type": "string",
          "description": "Release tag, or an empty string when this build is unreleased."
        },
        "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
      }
    }
  },
  "$defs": {
    "mirror": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref", "revision"],
      "properties": {
        "kind": {"enum": ["hf", "kaggle", "gdrive", "modelscope", "url"]},
        "ref": {"type": "string", "minLength": 1},
        "revision": {"type": "string"}
      }
    },
    "mirrors": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/mirror"}
    }
  }
}
